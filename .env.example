# ─────────────────────────────────────────────────────────────
# Crowdwink environment variables
# Copy to `.env.local` (Next.js) and `.env` (drizzle-kit / scripts).
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# Neon PostgreSQL (required)
# Pooled connection string from the Neon console ("Connection string" → Pooled).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection string, used only by drizzle-kit migrations. Optional:
# falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Real-time sync via Pusher Channels (required on Vercel / any multi-instance host)
# Create a free Channels app at https://dashboard.pusher.com. Any Pusher-protocol
# server (for example self-hosted Soketi) also works: set PUSHER_HOST/PORT/USE_TLS.
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us2"
# Optional, only for self-hosted Pusher-compatible servers such as Soketi:
# PUSHER_HOST="127.0.0.1"
# PUSHER_PORT="6001"
# PUSHER_USE_TLS="false"
# NEXT_PUBLIC_PUSHER_HOST="127.0.0.1"
# NEXT_PUBLIC_PUSHER_PORT="6001"
# NEXT_PUBLIC_PUSHER_USE_TLS="false"
#
# When the Pusher variables are empty, Crowdwink falls back to a built-in
# Server-Sent Events channel. That fallback only works when ONE Node process
# serves every request (`next dev`, or `next start` on a single server). It is
# NOT suitable for Vercel.

# Secret used by the cleanup cron endpoint (GET /api/cron/cleanup).
# Vercel Cron automatically sends `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET="change-me-to-a-long-random-string"

# Salt for hashing IP addresses used by rate limiting (any random string).
RATE_LIMIT_SALT="change-me-too"

# Public base URL used for invite links when the request host is unknown (optional).
# NEXT_PUBLIC_APP_URL="https://crowdwink.example.com"

# Development only: comma-separated LAN hostnames/IPs allowed to load the dev server.
# DEV_ALLOWED_ORIGINS="192.168.1.20"
